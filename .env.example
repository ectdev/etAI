# ---------------------------------------------------------------------------
# etAI environment configuration
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# These credentials match docker-compose.yml, so if you start the database with
# `docker compose up -d` this value works as it is.
DATABASE_URL=postgresql://etai:etai@localhost:5432/etai

# --- Authentication ---------------------------------------------------------
# Signs sessions and tokens. Generate a value with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Answer generation ------------------------------------------------------
# Writes the grounded answers and their citations. Two providers are supported.
# Switching between them is a matter of changing these two lines.
#
#   google     -> needs GOOGLE_GENERATIVE_AI_API_KEY only (the default, because
#                 embeddings already use this key, so one key runs everything)
#   anthropic  -> needs ANTHROPIC_API_KEY as well
#
GENERATION_PROVIDER=google
GENERATION_MODEL=gemini-3.6-flash

# Asked once when the model above is overloaded, rate limited or down after its own
# retries. Same provider, so the same key. Leave empty for no fallback. Every answer
# reports the model that actually wrote it, so a fallback never passes as the primary.
GENERATION_FALLBACK_MODEL=gemini-3.5-flash

# Only needed when GENERATION_PROVIDER=anthropic.
# Create a key at https://console.anthropic.com
# Suggested model: claude-sonnet-5
ANTHROPIC_API_KEY=

# --- Embeddings -------------------------------------------------------------
# Turns documents and search queries into vectors.
#
#   google   -> the real model, and the only one retrieval quality is measured
#               against. Needs GOOGLE_GENERATIVE_AI_API_KEY, because the Anthropic
#               API has no embeddings endpoint.
#   hashing  -> no key, no network. Hashes the words of a text into the vector, so
#               search by shared words works and search by meaning does not. For
#               trying the project before creating a key, and for CI.
#
# Changing either line below makes every stored vector stale. The next
# pnpm ingest --write notices and embeds them again; until then search falls back
# to keyword only rather than comparing vectors from two different models.
EMBEDDING_PROVIDER=google
# Create a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2

# The model returns 3072 numbers by default, but pgvector cannot build an HNSW
# index above 2000. Asking for 1536 stays under that limit, and the model still
# returns a unit-length vector at this size, so cosine distance works directly.
EMBEDDING_DIMENSIONS=1536

# --- Ingestion --------------------------------------------------------------
# Folder the pipeline reads. Point it at any folder of markdown files to index a
# different set of documents.
CORPUS_PATH=./corpus

# Keeps `pnpm ingest --write` running and reindexes when a markdown file under
# CORPUS_PATH changes. Off unless the value is exactly "true": the command
# normally finishes, and each reindex it starts spends money at the embedding
# API. Stop it with Ctrl-C.
INGEST_WATCH=false

# --- MCP server -------------------------------------------------------------
# Port for the HTTP transport. The stdio transport does not need a port.
MCP_HTTP_PORT=3001
